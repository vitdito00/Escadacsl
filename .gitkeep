 (cd "$(git rev-parse --show-toplevel)" && git apply --3way <<'EOF' 
diff --git a/README.md b/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..a64f4beb0abc687950c72f6873edf1aa8140f044
--- /dev/null
+++ b/README.md
@@ -0,0 +1,33 @@
+# Escada para o Céu
+
+Aplicação web moderna do CLJ Capela Santa Luzia com ranking litúrgico, painel de participante e painel administrativo separado.
+
+## Executar localmente
+
+```bash
+python3 -m http.server 4173
+```
+
+Abra:
+- `http://localhost:4173/index.html` (site público)
+- `http://localhost:4173/login.html` (login/cadastro + painel pessoal)
+- `http://localhost:4173/admin.html` (admin)
+
+## Regras principais
+
+- Pontuação simbólica: semana = +1, dominical = +2, grupo = +3.
+- Participantes não alteram pontos.
+- Admin protegido por senha fixa `lit2026`.
+- Persistência local em `localStorage` para facilitar futura migração para backend real.
+
+## Imagens oficiais (logos e nuvem)
+
+Coloque os arquivos abaixo em `assets/` para usar as artes oficiais:
+- `clj.png`
+- `escada.png`
+- `nuvem.png`
+
+O front já está configurado para tentar esses PNGs primeiro, com fallback para os SVGs atuais caso os PNGs ainda não existam.
+
+
+Arquivos já adicionados no repositório: `assets/clj.png`, `assets/escada.png`, `assets/nuvem.png`.
diff --git a/admin.html b/admin.html
new file mode 100644
index 0000000000000000000000000000000000000000..289e515bb8a9fb193ab948cb15cb481a3c51d54f
--- /dev/null
+++ b/admin.html
@@ -0,0 +1,71 @@
+<!doctype html>
+<html lang="pt-BR">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>Admin | Escada para o Céu</title>
+    <link rel="preconnect" href="https://fonts.googleapis.com" />
+    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
+    <link rel="stylesheet" href="styles.css" />
+  </head>
+  <body>
+    <div class="ambient-glow"></div>
+    <main class="container compact">
+      <header class="topbar glass">
+        <div class="brand-wrap">
+          <img src="assets/escada.png" onerror="this.onerror=null;this.src='assets/logo-clj.svg'" alt="CLJ" class="logo-org" />
+          <img src="assets/nuvem.png" onerror="this.onerror=null;this.src='assets/logo-ceu.svg'" alt="Escada para o Céu" class="logo-proj" />
+        </div>
+        <nav class="top-actions">
+          <a class="btn-soft" href="index.html">Início</a>
+          <a class="btn-soft" href="login.html">Login</a>
+        </nav>
+      </header>
+
+      <section class="panel glass">
+        <h2>Painel Administrativo</h2>
+        <div class="card">
+          <label>Senha administrativa fixa
+            <input type="password" id="adminPassword" placeholder="lit2026" />
+          </label>
+          <button id="unlockAdmin" class="btn-gold">Desbloquear</button>
+          <p id="adminMessage" class="feedback"></p>
+        </div>
+      </section>
+
+      <section id="adminPanel" class="panel glass hidden">
+        <div class="admin-grid">
+          <article class="card">
+            <h3>Participantes</h3>
+            <form id="addParticipantForm" class="stack">
+              <input name="username" placeholder="Nome" required />
+              <input type="password" name="password" placeholder="Senha" required />
+              <button class="btn-soft" type="submit">Adicionar participante</button>
+            </form>
+            <div id="participantAdminList"></div>
+            <button id="resetRanking" class="btn-danger" type="button">Resetar ranking</button>
+          </article>
+
+          <article class="card">
+            <h3>Eventos e Avisos</h3>
+            <form id="eventForm" class="stack">
+              <input type="date" name="date" required />
+              <input name="title" placeholder="Título" required />
+              <select name="type">
+                <option value="semana">Missa da semana (+1)</option>
+                <option value="dominical">Missa Dominical (+2)</option>
+                <option value="grupo">Missa do grupo (+3)</option>
+              </select>
+              <textarea name="description" placeholder="Descrição" required></textarea>
+              <button class="btn-soft" type="submit">Salvar evento</button>
+            </form>
+            <div id="eventAdminList"></div>
+          </article>
+        </div>
+      </section>
+    </main>
+
+    <script type="module" src="admin.js"></script>
+  </body>
+</html>
diff --git a/admin.js b/admin.js
new file mode 100644
index 0000000000000000000000000000000000000000..5726a2803bbd4f90af2a4add71db158367a9573e
--- /dev/null
+++ b/admin.js
@@ -0,0 +1,111 @@
+import { SCORE_VALUES, byPoints, ensureSeedPasswords, hash, loadDB, saveDB } from './shared.js';
+
+const db = loadDB();
+await ensureSeedPasswords(db);
+
+const adminPanel = document.getElementById('adminPanel');
+const adminMessage = document.getElementById('adminMessage');
+
+document.getElementById('unlockAdmin').addEventListener('click', () => {
+  if (document.getElementById('adminPassword').value !== 'lit2026') {
+    adminMessage.textContent = 'Senha incorreta.';
+    return;
+  }
+  adminMessage.textContent = 'Acesso liberado.';
+  adminPanel.classList.remove('hidden');
+  renderAdmin();
+});
+
+document.getElementById('addParticipantForm').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const fd = new FormData(e.target);
+  const username = fd.get('username').toString().trim();
+  const password = fd.get('password').toString();
+  if (db.participants.some((p) => p.username.toLowerCase() === username.toLowerCase())) {
+    adminMessage.textContent = 'Participante já existe.';
+    return;
+  }
+  db.participants.push({ id: crypto.randomUUID(), username, passwordHash: await hash(password), points: 0 });
+  saveDB(db);
+  e.target.reset();
+  renderAdmin();
+});
+
+document.getElementById('eventForm').addEventListener('submit', (e) => {
+  e.preventDefault();
+  const fd = new FormData(e.target);
+  db.events.push({
+    id: crypto.randomUUID(),
+    date: fd.get('date').toString(),
+    title: fd.get('title').toString(),
+    description: fd.get('description').toString(),
+    type: fd.get('type').toString()
+  });
+  saveDB(db);
+  e.target.reset();
+  renderAdmin();
+});
+
+document.getElementById('resetRanking').addEventListener('click', () => {
+  db.participants = db.participants.map((p) => ({ ...p, points: 0 }));
+  saveDB(db);
+  renderAdmin();
+});
+
+function renderAdmin() {
+  const users = document.getElementById('participantAdminList');
+  users.innerHTML = '';
+
+  [...db.participants].sort(byPoints).forEach((p) => {
+    const row = document.createElement('div');
+    row.className = 'admin-row';
+    row.innerHTML = `
+      <input data-name="${p.id}" value="${p.username}" />
+      <button data-op="semana" data-id="${p.id}">+1</button>
+      <button data-op="dominical" data-id="${p.id}">+2</button>
+      <button data-op="grupo" data-id="${p.id}">+3</button>
+      <button data-op="sub" data-id="${p.id}">-1</button>
+      <button data-op="del" data-id="${p.id}" class="btn-danger">Excluir</button>`;
+    users.appendChild(row);
+  });
+
+  users.querySelectorAll('input[data-name]').forEach((input) => {
+    input.addEventListener('change', () => {
+      const p = db.participants.find((item) => item.id === input.dataset.name);
+      if (!p) return;
+      p.username = input.value.trim() || p.username;
+      saveDB(db);
+    });
+  });
+
+  users.querySelectorAll('button[data-op]').forEach((btn) => {
+    btn.addEventListener('click', () => {
+      const p = db.participants.find((item) => item.id === btn.dataset.id);
+      if (!p) return;
+      if (btn.dataset.op in SCORE_VALUES) p.points += SCORE_VALUES[btn.dataset.op];
+      if (btn.dataset.op === 'sub') p.points = Math.max(0, p.points - 1);
+      if (btn.dataset.op === 'del') db.participants = db.participants.filter((u) => u.id !== p.id);
+      saveDB(db);
+      renderAdmin();
+    });
+  });
+
+  const events = document.getElementById('eventAdminList');
+  events.innerHTML = '';
+  db.events
+    .sort((a, b) => a.date.localeCompare(b.date))
+    .forEach((ev) => {
+      const row = document.createElement('div');
+      row.className = 'admin-row';
+      row.innerHTML = `<span>${new Date(ev.date).toLocaleDateString('pt-BR')} • ${ev.title}</span><button data-eid="${ev.id}" class="btn-danger">Excluir</button>`;
+      events.appendChild(row);
+    });
+
+  events.querySelectorAll('button[data-eid]').forEach((btn) => {
+    btn.addEventListener('click', () => {
+      db.events = db.events.filter((ev) => ev.id !== btn.dataset.eid);
+      saveDB(db);
+      renderAdmin();
+    });
+  });
+}
diff --git a/app.js b/app.js
new file mode 100644
index 0000000000000000000000000000000000000000..e247203d98302245b9a14151f0cf7ff814420024
--- /dev/null
+++ b/app.js
@@ -0,0 +1,65 @@
+import { MIRACLES, byPoints, ensureSeedPasswords, loadDB } from './shared.js';
+
+const db = loadDB();
+await ensureSeedPasswords(db);
+
+const rankingSteps = document.getElementById('rankingSteps');
+const eventsList = document.getElementById('eventsList');
+const modal = document.getElementById('modal');
+const modalBody = document.getElementById('modalBody');
+
+drawRanking();
+drawEvents();
+drawGallery();
+
+document.getElementById('closeModal').addEventListener('click', () => modal.classList.add('hidden'));
+modal.addEventListener('click', (e) => {
+  if (e.target.id === 'modal') modal.classList.add('hidden');
+});
+
+function drawRanking() {
+  rankingSteps.innerHTML = '';
+  db.participants.sort(byPoints).forEach((p, i) => {
+    const row = document.createElement('article');
+    const medal = i === 0 ? '👑' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i + 1}`;
+    row.className = `step ${i < 3 ? `top-${i + 1}` : ''}`;
+    row.innerHTML = `
+      <div class="step-badge">${medal}</div>
+      <div class="step-main">
+        <strong>${p.username}</strong>
+        <small>↗ ${p.points} degraus</small>
+      </div>
+      <div class="step-points">${p.points}</div>`;
+    rankingSteps.appendChild(row);
+  });
+}
+
+function drawEvents() {
+  const now = new Date();
+  eventsList.innerHTML = '';
+  db.events
+    .sort((a, b) => a.date.localeCompare(b.date))
+    .forEach((event) => {
+      const dt = new Date(`${event.date}T00:00:00`);
+      const inDays = Math.ceil((dt - now) / 86400000);
+      const soon = inDays >= 0 && inDays <= 7;
+      const card = document.createElement('article');
+      card.className = `card event ${soon ? 'soon' : ''}`;
+      card.innerHTML = `<h3>${event.title}${soon ? '<span class="pill">Em breve</span>' : ''}</h3><p><b>${dt.toLocaleDateString('pt-BR')}</b></p><p>${event.description}</p>`;
+      eventsList.appendChild(card);
+    });
+}
+
+function drawGallery() {
+  const wrap = document.getElementById('miracleGallery');
+  MIRACLES.forEach((m) => {
+    const card = document.createElement('article');
+    card.className = 'card miracle';
+    card.innerHTML = `<div class="placeholder"></div><h4>${m.name}</h4><p>${m.place} • ${m.date}</p><p>${m.summary}</p>`;
+    card.addEventListener('click', () => {
+      modalBody.innerHTML = `<h3>${m.name}</h3><p><b>Local:</b> ${m.place}</p><p><b>Data:</b> ${m.date}</p><p>${m.summary}</p>`;
+      modal.classList.remove('hidden');
+    });
+    wrap.appendChild(card);
+  });
+}
