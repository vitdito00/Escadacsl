diff --git a/index.html b/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..385c1418aaaa80c4df716e47929d86556767c477
--- /dev/null
+++ b/index.html
@@ -0,0 +1,79 @@
+<!doctype html>
+<html lang="pt-BR">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>Escada para o Céu | CLJ Capela Santa Luzia</title>
+    <link rel="preconnect" href="https://fonts.googleapis.com" />
+    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
+    <link rel="stylesheet" href="styles.css" />
+  </head>
+  <body>
+    <div class="ambient-glow"></div>
+    <div class="particles"></div>
+    <div class="clouds">
+      <img src="assets/clj.png" onerror="this.onerror=null;this.src='assets/cloud.svg'" alt="" class="cloud c1" />
+      <img src="assets/clj.png" onerror="this.onerror=null;this.src='assets/cloud.svg'" alt="" class="cloud c2" />
+      <img src="assets/clj.png" onerror="this.onerror=null;this.src='assets/cloud.svg'" alt="" class="cloud c3" />
+    </div>
+
+    <header class="topbar glass">
+      <div class="brand-wrap">
+        <img src="assets/escada.png" onerror="this.onerror=null;this.src='assets/logo-clj.svg'" alt="CLJ Capela Santa Luzia" class="logo-org" />
+        <img src="assets/nuvem.png" onerror="this.onerror=null;this.src='assets/logo-ceu.svg'" alt="Escada para o Céu" class="logo-proj" />
+      </div>
+      <nav class="top-actions">
+        <a class="nav-link" href="#ranking">Ranking</a>
+        <a class="nav-link" href="#eventos">Eventos</a>
+        <a class="btn-soft" href="login.html">Login</a>
+        <a class="btn-gold" href="admin.html">Admin</a>
+      </nav>
+    </header>
+
+    <main class="container">
+      <section class="hero">
+        <img src="assets/nuvem.png" onerror="this.onerror=null;this.src='assets/logo-ceu.svg'" alt="Escada para o Céu" class="hero-logo" />
+        <h1>Uma jornada de fé rumo ao Céu</h1>
+        <p>Cada Missa é um degrau. Participe, cresça em espiritualidade e caminhe com seu grupo rumo ao Alto.</p>
+        <a class="btn-gold" href="#ranking">Ver degraus</a>
+      </section>
+
+      <section id="ranking" class="panel glass">
+        <div class="panel-head">
+          <h2>ESCADA PARA O CEU</h2>
+          <small>Cada Missa e um degrau na subida para o Ceu. Acompanhe sua jornada e a de seus irmaos na fe.</small>
+        </div>
+        <div class="ranking-path"><div class="path-line"></div><div id="rankingSteps" class="stairs"></div></div>
+        <p class="ranking-footer">“Caminhando juntos em direcao a Casa do Pai”</p>
+      </section>
+
+      <section id="eventos" class="panel glass">
+        <h2>Datas e Próximas Missas</h2>
+        <div id="eventsList" class="events-grid"></div>
+      </section>
+
+      <section id="inspirado" class="panel glass">
+        <h2>Inspirado por São Carlo Acutis</h2>
+        <div class="acutis">
+          <img src="assets/carlo.svg" alt="São Carlo Acutis" class="acutis-photo" />
+          <div>
+            <p>Um jovem que viveu com intensidade a presença de Jesus na Eucaristia, usando os meios digitais para evangelizar e reacender corações.</p>
+            <blockquote>“A Eucaristia é a minha autoestrada para o Céu.”</blockquote>
+          </div>
+        </div>
+        <h3>Exposição Virtual de Milagres Eucarísticos</h3>
+        <div id="miracleGallery" class="gallery"></div>
+      </section>
+    </main>
+
+    <div id="modal" class="modal hidden">
+      <div class="modal-content glass">
+        <button id="closeModal" class="close">×</button>
+        <div id="modalBody"></div>
+      </div>
+    </div>
+
+    <script type="module" src="app.js"></script>
+  </body>
+</html>
diff --git a/login.html b/login.html
new file mode 100644
index 0000000000000000000000000000000000000000..98c59caeda5bcf28d9bb3639dd67e502180bfdb8
--- /dev/null
+++ b/login.html
@@ -0,0 +1,62 @@
+<!doctype html>
+<html lang="pt-BR">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>Login | Escada para o Céu</title>
+    <link rel="preconnect" href="https://fonts.googleapis.com" />
+    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
+    <link rel="stylesheet" href="styles.css" />
+  </head>
+  <body>
+    <div class="ambient-glow"></div>
+    <main class="container compact">
+      <header class="topbar glass">
+        <div class="brand-wrap">
+          <img src="assets/escada.png" onerror="this.onerror=null;this.src='assets/logo-clj.svg'" alt="CLJ" class="logo-org" />
+          <img src="assets/nuvem.png" onerror="this.onerror=null;this.src='assets/logo-ceu.svg'" alt="Escada para o Céu" class="logo-proj" />
+        </div>
+        <nav class="top-actions">
+          <a class="btn-soft" href="index.html">Início</a>
+          <a class="btn-gold" href="admin.html">Admin</a>
+        </nav>
+      </header>
+
+      <section class="panel glass">
+        <h2>Entrar ou Criar Conta</h2>
+        <div class="auth-grid">
+          <form id="loginForm" class="card">
+            <h3>Login</h3>
+            <label>Nome de usuário<input name="username" required /></label>
+            <label>Senha<input type="password" name="password" required /></label>
+            <button class="btn-gold" type="submit">Entrar</button>
+          </form>
+          <form id="registerForm" class="card">
+            <h3>Cadastro</h3>
+            <label>Nome de usuário<input name="username" required /></label>
+            <label>Senha<input type="password" minlength="4" name="password" required /></label>
+            <button class="btn-soft" type="submit">Criar conta</button>
+          </form>
+        </div>
+        <p id="authMessage" class="feedback"></p>
+      </section>
+
+      <section id="painel-usuario" class="panel glass hidden">
+        <h2>Seu Painel Espiritual</h2>
+        <div class="stats-grid">
+          <article class="card"><h3>Pontos</h3><p id="myPoints" class="metric">0</p></article>
+          <article class="card"><h3>Posição</h3><p id="myRank" class="metric">-</p></article>
+          <article class="card"><h3>Próximo degrau</h3><p id="gapToNext" class="metric small">-</p></article>
+        </div>
+        <article class="card">
+          <p class="motto">Cada Missa é um degrau.</p>
+          <div class="progress"><span id="progressBar"></span></div>
+          <small id="progressLabel"></small>
+        </article>
+      </section>
+    </main>
+
+    <script type="module" src="login.js"></script>
+  </body>
+</html>
diff --git a/login.js b/login.js
new file mode 100644
index 0000000000000000000000000000000000000000..77d92c67f4df23ab9df8ce2846272d4319a00f75
--- /dev/null
+++ b/login.js
@@ -0,0 +1,69 @@
+import { byPoints, ensureSeedPasswords, hash, loadDB, loadSession, saveDB, saveSession } from './shared.js';
+
+const db = loadDB();
+await ensureSeedPasswords(db);
+
+const msg = document.getElementById('authMessage');
+const panel = document.getElementById('painel-usuario');
+
+document.getElementById('registerForm').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const fd = new FormData(e.target);
+  const username = fd.get('username').toString().trim();
+  const password = fd.get('password').toString();
+
+  if (db.participants.some((p) => p.username.toLowerCase() === username.toLowerCase())) {
+    msg.textContent = 'Nome de usuário já existe.';
+    return;
+  }
+
+  db.participants.push({ id: crypto.randomUUID(), username, passwordHash: await hash(password), points: 0 });
+  saveDB(db);
+  e.target.reset();
+  msg.textContent = 'Cadastro concluído. Agora faça login.';
+});
+
+document.getElementById('loginForm').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const fd = new FormData(e.target);
+  const username = fd.get('username').toString().trim();
+  const password = fd.get('password').toString();
+  const user = db.participants.find((p) => p.username.toLowerCase() === username.toLowerCase());
+
+  if (!user || user.passwordHash !== await hash(password)) {
+    msg.textContent = 'Credenciais inválidas.';
+    return;
+  }
+
+  saveSession({ userId: user.id });
+  msg.textContent = `Bem-vindo(a), ${user.username}.`;
+  renderPanel();
+});
+
+renderPanel();
+
+function renderPanel() {
+  const current = loadSession();
+  if (!current) {
+    panel.classList.add('hidden');
+    return;
+  }
+
+  const ranking = [...db.participants].sort(byPoints);
+  const me = ranking.find((p) => p.id === current.userId);
+  if (!me) return;
+
+  panel.classList.remove('hidden');
+  const idx = ranking.findIndex((p) => p.id === me.id);
+  const next = ranking[idx - 1];
+  const needed = next ? next.points - me.points + 1 : 0;
+
+  document.getElementById('myPoints').textContent = `${me.points}`;
+  document.getElementById('myRank').textContent = `#${idx + 1}`;
+  document.getElementById('gapToNext').textContent = next ? `${needed} pts para ultrapassar ${next.username}` : 'Você está no topo';
+
+  const max = Math.max(1, ranking[0]?.points || 1);
+  const pct = Math.round((me.points / max) * 100);
+  document.getElementById('progressBar').style.width = `${pct}%`;
+  document.getElementById('progressLabel').textContent = `${pct}% da subida em relação ao líder`;
+}
diff --git a/shared.js b/shared.js
new file mode 100644
index 0000000000000000000000000000000000000000..ab6d2ee853dab7a961346b039299e39c52b62ec1
--- /dev/null
+++ b/shared.js
@@ -0,0 +1,64 @@
+export const STORAGE_KEY = 'escada-ceu-db-v2';
+export const SESSION_KEY = 'escada-ceu-session-v2';
+
+export const DEFAULT_DB = {
+  participants: [
+    { id: crypto.randomUUID(), username: 'Ana', passwordHash: '', points: 14 },
+    { id: crypto.randomUUID(), username: 'Lucas', passwordHash: '', points: 12 },
+    { id: crypto.randomUUID(), username: 'Maria', passwordHash: '', points: 10 },
+    { id: crypto.randomUUID(), username: 'João', passwordHash: '', points: 7 }
+  ],
+  events: [
+    { id: crypto.randomUUID(), date: '2026-02-16', title: 'Missa da Semana', description: 'Celebração diária para fortalecer a caminhada de fé.', type: 'semana' },
+    { id: crypto.randomUUID(), date: '2026-02-22', title: 'Missa Dominical', description: 'Missa principal da comunidade às 19h.', type: 'dominical' },
+    { id: crypto.randomUUID(), date: '2026-02-28', title: 'Missa do Grupo CLJ', description: 'Missa do grupo com momento de envio missionário.', type: 'grupo' }
+  ]
+};
+
+export const MIRACLES = [
+  { name: 'Lanciano', place: 'Itália', date: 'Séc. VIII', summary: 'Durante a Santa Missa, a hóstia teria se transformado em carne e o vinho em sangue.' },
+  { name: 'Santarém', place: 'Portugal', date: '1247', summary: 'Relato de hóstia eucarística com sinais extraordinários preservada para veneração.' },
+  { name: 'Buenos Aires', place: 'Argentina', date: '1996', summary: 'Casos eucarísticos estudados e divulgados para reacender a fé na presença real.' },
+  { name: 'Tixtla', place: 'México', date: '2006', summary: 'Evento ligado à adoração eucarística com grande repercussão espiritual.' }
+];
+
+export const SCORE_VALUES = { semana: 1, dominical: 2, grupo: 3 };
+
+export const byPoints = (a, b) => b.points - a.points || a.username.localeCompare(b.username);
+
+export function loadDB() {
+  const raw = localStorage.getItem(STORAGE_KEY);
+  if (raw) return JSON.parse(raw);
+  const cloned = structuredClone(DEFAULT_DB);
+  localStorage.setItem(STORAGE_KEY, JSON.stringify(cloned));
+  return cloned;
+}
+
+export function saveDB(db) {
+  localStorage.setItem(STORAGE_KEY, JSON.stringify(db));
+}
+
+export function loadSession() {
+  return JSON.parse(localStorage.getItem(SESSION_KEY) || 'null');
+}
+
+export function saveSession(session) {
+  localStorage.setItem(SESSION_KEY, JSON.stringify(session));
+}
+
+export async function hash(value) {
+  const bytes = new TextEncoder().encode(value);
+  const digest = await crypto.subtle.digest('SHA-256', bytes);
+  return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+export async function ensureSeedPasswords(db) {
+  let changed = false;
+  for (const p of db.participants) {
+    if (!p.passwordHash) {
+      p.passwordHash = await hash('1234');
+      changed = true;
+    }
+  }
+  if (changed) saveDB(db);
+}
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000000000000000000000000000000000000..c5ebe08b0884e411545a2d2b34655cab63cbc895
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,207 @@
+:root {
+  --bg1: #1e4f9b;
+  --bg2: #0c2148;
+  --bg3: #06132f;
+  --text: #ecf2ff;
+  --muted: #bed0f3;
+  --gold: #f7c94f;
+  --glass: rgba(15, 34, 72, 0.58);
+  --line: rgba(255, 255, 255, 0.16);
+}
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body {
+  margin: 0;
+  color: var(--text);
+  font-family: Inter, sans-serif;
+  background: linear-gradient(180deg, var(--bg1), var(--bg2) 42%, var(--bg3));
+  min-height: 100vh;
+  overflow-x: hidden;
+}
+h1, h2, h3, h4 { font-family: Cinzel, serif; margin: 0; }
+p { margin: .4rem 0; }
+
+.ambient-glow {
+  position: fixed;
+  inset: 0;
+  background: radial-gradient(circle at top, rgba(255,255,255,.25), transparent 42%);
+  pointer-events: none;
+}
+.particles {
+  position: fixed;
+  inset: 0;
+  background-image: radial-gradient(circle, rgba(255,255,255,.8) 1px, transparent 2px);
+  background-size: 120px 120px;
+  opacity: .26;
+  animation: rise 24s linear infinite;
+  pointer-events: none;
+}
+@keyframes rise { to { transform: translateY(-120px); } }
+.clouds { position: fixed; inset: 0; overflow: hidden; pointer-events: none; }
+.cloud { position: absolute; width: min(28vw, 260px); opacity: .6; }
+.c1 { top: 15%; left: -20%; animation: cloud 38s linear infinite; }
+.c2 { top: 50%; left: -30%; animation: cloud 50s linear infinite 4s; }
+.c3 { top: 75%; left: -25%; animation: cloud 60s linear infinite 9s; }
+@keyframes cloud { to { transform: translateX(140vw);} }
+
+.container { width: min(1120px, 94%); margin: 0 auto; padding-bottom: 3rem; }
+.container.compact { width: min(980px, 94%); }
+.glass { background: var(--glass); border: 1px solid var(--line); backdrop-filter: blur(10px); box-shadow: 0 18px 35px rgba(0,0,0,.24); }
+.topbar {
+  position: sticky;
+  top: .8rem;
+  z-index: 10;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin: .8rem 0 1.2rem;
+  border-radius: 20px;
+  padding: .7rem 1rem;
+  gap: 1rem;
+}
+.brand-wrap { display: flex; align-items: center; gap: .8rem; }
+.logo-org { width: 80px; }
+.logo-proj { width: 126px; }
+.top-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
+.nav-link, .btn-soft, .btn-gold, .btn-danger {
+  border: 0;
+  border-radius: 999px;
+  text-decoration: none;
+  padding: .58rem .95rem;
+  font-weight: 700;
+  cursor: pointer;
+  transition: .2s transform, .2s box-shadow;
+}
+.nav-link { color: var(--text); opacity: .9; padding-top: .67rem; }
+.btn-soft { background: #dbe8ff; color: #123063; }
+.btn-gold { background: var(--gold); color: #362603; box-shadow: 0 0 14px rgba(247,201,79,.45); }
+.btn-danger { background: #f58f8f; color: #3d0e0e; }
+.nav-link:hover, .btn-soft:hover, .btn-gold:hover, .btn-danger:hover { transform: translateY(-2px); }
+
+.hero { text-align: center; padding: 3.6rem .8rem 2.4rem; }
+.hero-logo { width: min(420px, 92%); filter: drop-shadow(0 0 20px rgba(247,201,79,.2)); }
+.hero h1 { margin-top: .8rem; }
+.hero p { color: var(--muted); max-width: 680px; margin: .8rem auto 1.2rem; }
+
+.panel { border-radius: 24px; margin: 1rem 0; padding: 1.2rem; }
+.card { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.13); border-radius: 16px; padding: .9rem; }
+.panel-head { text-align: center; margin-bottom: 1rem; }
+.panel-head h2 { color: var(--gold); letter-spacing: 1px; }
+.panel-head small { color: #95aad1; max-width: 640px; margin: .35rem auto 0; display: block; }
+
+.ranking-path { position: relative; max-width: 780px; margin: 0 auto; }
+.path-line {
+  position: absolute;
+  left: 22px;
+  top: 14px;
+  bottom: 16px;
+  width: 2px;
+  background: linear-gradient(180deg, rgba(247,201,79,.5), rgba(158,191,241,.25));
+  z-index: 0;
+}
+.stairs { display: flex; flex-direction: column; gap: .85rem; position: relative; z-index: 1; }
+.step {
+  display: grid;
+  grid-template-columns: 48px 1fr auto;
+  gap: .9rem;
+  align-items: center;
+  border-radius: 14px;
+  padding: .95rem 1rem;
+  background: linear-gradient(120deg, rgba(21,56,105,.9), rgba(13,44,90,.78));
+  border: 1px solid rgba(143,180,232,.25);
+  box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
+  animation: pop .45s ease;
+}
+.step:nth-child(2) { margin-left: 12px; }
+.step:nth-child(3) { margin-left: 0; }
+.step:nth-child(4) { margin-left: 14px; }
+.step:nth-child(5) { margin-left: 0; }
+.step-badge {
+  width: 36px;
+  height: 36px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  font-weight: 700;
+  background: rgba(186,212,250,.14);
+  color: #bdd3f7;
+  border: 1px solid rgba(177,201,238,.2);
+}
+.step-main strong {
+  font-family: Cinzel, serif;
+  font-size: 1.05rem;
+  text-transform: uppercase;
+  letter-spacing: .4px;
+}
+.step-main small { display: block; color: #b4c6e8; margin-top: .15rem; }
+.step-points { color: var(--gold); font-weight: 700; font-size: 2rem; line-height: 1; }
+
+.step.top-1 { border-color: rgba(247,201,79,.78); box-shadow: 0 0 22px rgba(247,201,79,.25); }
+.step.top-1 .step-badge { color: var(--gold); border-color: rgba(247,201,79,.45); }
+.step.top-2 { border-color: rgba(202,216,238,.65); box-shadow: 0 0 20px rgba(202,216,238,.18); }
+.step.top-3 { border-color: rgba(210,150,72,.55); box-shadow: 0 0 20px rgba(210,150,72,.15); }
+
+.ranking-footer {
+  text-align: center;
+  color: var(--gold);
+  font-family: Cinzel, serif;
+  font-style: italic;
+  margin-top: 1.8rem;
+  opacity: .95;
+}
+
+@media (max-width: 760px) {
+  .step { grid-template-columns: 42px 1fr auto; }
+  .step-main strong { font-size: .92rem; }
+  .step-points { font-size: 1.7rem; }
+}
+
+.events-grid { display: grid; gap: .7rem; }
+.event { border-left: 4px solid #9fc3ff; }
+.event.soon { border-left-color: var(--gold); box-shadow: 0 0 16px rgba(247,201,79,.22); }
+.pill { display: inline-block; margin-left: .5rem; background: var(--gold); color: #362603; font-size: .72rem; padding: .12rem .5rem; border-radius: 999px; }
+
+.acutis { display: grid; grid-template-columns: 190px 1fr; gap: 1rem; align-items: center; }
+.acutis-photo { width: 100%; border-radius: 16px; border: 1px solid rgba(255,255,255,.22); }
+blockquote { color: var(--gold); font-size: 1.18rem; }
+.gallery { display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
+.miracle { cursor: pointer; transition: .22s transform; }
+.miracle:hover { transform: translateY(-3px); }
+.placeholder { height: 102px; border-radius: 12px; background: linear-gradient(135deg, #cfddff44, #f7c94f55); margin-bottom: .6rem; }
+
+.auth-grid { display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
+label { display: grid; gap: .35rem; margin: .5rem 0; }
+input, textarea, select, button { font: inherit; }
+input, textarea, select {
+  border: 1px solid rgba(255,255,255,.24);
+  border-radius: 10px;
+  background: rgba(7,20,45,.56);
+  color: white;
+  padding: .56rem .66rem;
+}
+.feedback { color: var(--gold); font-weight: 600; }
+.hidden { display: none !important; }
+
+.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px,1fr)); gap: .6rem; }
+.metric { font-size: 2rem; color: var(--gold); margin: .2rem 0; }
+.metric.small { font-size: 1rem; color: var(--text); }
+.motto { font-size: 1rem; color: var(--muted); }
+.progress { width: 100%; height: 12px; border-radius: 999px; background: rgba(255,255,255,.15); overflow: hidden; }
+.progress span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #f9ddb4, var(--gold)); transition: width .7s ease; }
+
+.admin-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: .8rem; }
+.stack { display: grid; gap: .5rem; margin-bottom: .6rem; }
+.admin-row { display: grid; grid-template-columns: 1fr repeat(5, auto); gap: .35rem; margin: .4rem 0; align-items: center; }
+.admin-row button { border-radius: 9px; border: 0; padding: .32rem .48rem; }
+
+.modal { position: fixed; inset: 0; display: grid; place-items: center; background: rgba(2,8,22,.7); z-index: 30; }
+.modal-content { width: min(620px, 95vw); border-radius: 18px; padding: 1rem; position: relative; }
+.close { position: absolute; top: .35rem; right: .7rem; border: 0; background: none; color: white; font-size: 2rem; cursor: pointer; }
+
+@media (max-width: 760px) {
+  .topbar { top: .35rem; }
+  .nav-link { display: none; }
+  .logo-org { width: 64px; }
+  .logo-proj { width: 100px; }
+  .acutis { grid-template-columns: 1fr; }
+}
 
EOF
)
